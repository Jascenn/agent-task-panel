/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests

/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/appicon.png
  Cache-Control: public, max-age=31536000, immutable

/appicon-256.png
  Cache-Control: public, max-age=31536000, immutable
